DATABASE_URL="postgresql://postgres:password@localhost:5432/vulnguard_ai"
JWT_SECRET="replace-with-a-long-random-secret"
PORT="3000"
CORS_ORIGIN="http://localhost:5173"

# Use "rules" for the local deterministic engine or "openai" for live AI.
AI_PROVIDER="rules"
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-5-mini"

# Use AI_PROVIDER="nvidia" to call the protected FastAPI AI microservice.
AI_SERVICE_URL="http://localhost:8000"
AI_SERVICE_TOKEN="replace-with-the-same-ai-service-secret"

# Optional. Increases official NVD API rate limits for CVE lookups.
NVD_API_KEY=""

# Optional read-only tokens for higher API limits or private repository access.
GITHUB_TOKEN=""
GITLAB_TOKEN=""

# Optional high-priority vulnerability email alerts.
EMAIL_NOTIFICATIONS_ENABLED="false"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="VulnGuard AI <alerts@example.com>"
FRONTEND_URL="http://localhost:5173"
