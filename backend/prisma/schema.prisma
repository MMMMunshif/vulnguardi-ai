generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id          String             @id @default(uuid())
  name        String
  email       String             @unique
  phone       String?
  website     String?
  industry    String?
  country     String?
  status      OrganizationStatus @default(ACTIVE)

  users                   User[]
  departments             Department[]
  devices                 Device[]
  softwareInventory       SoftwareInventory[]
  softwareUpdateFindings  SoftwareUpdateFinding[]
  vulnerabilityFindings   VulnerabilityFinding[]
  remediationActions      RemediationAction[]
  auditLogs               AuditLog[]
  remediationEvidence     RemediationEvidence[]

  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
}

model Role {
  id          String   @id @default(uuid())
  roleName    String   @unique
  description String?

  users       User[]

  createdAt   DateTime @default(now())
}

model Department {
  id             String       @id @default(uuid())
  name           String
  description    String?

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  users          User[]

  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model User {
  id              String       @id @default(uuid())

  firstName       String
  lastName        String

  email           String       @unique
  password        String

  phone           String?
  profileImage    String?

  status          UserStatus   @default(ACTIVE)

  lastLogin       DateTime?
  emailVerifiedAt DateTime?

  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  departmentId    String
  department      Department   @relation(fields: [departmentId], references: [id])

  roleId          String
  role            Role         @relation(fields: [roleId], references: [id])

  assignedDevices            Device[]
  assignedRemediationActions RemediationAction[]
  auditLogs                  AuditLog[]
  passwordResetTokens       PasswordResetToken[]
  emailVerificationTokens  EmailVerificationToken[]
  refreshTokens            RefreshToken[]
  remediationEvidence     RemediationEvidence[]

  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model EmailVerificationToken {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model RefreshToken {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model AuditLog {
  id             String       @id @default(uuid())
  action         String
  resource       String
  resourceId     String?
  method         String
  path           String
  statusCode     Int
  actorEmail     String
  message        String?

  userId         String?
  user           User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdAt      DateTime     @default(now())

  @@index([organizationId, createdAt])
  @@index([userId, createdAt])
  @@index([resource, action])
}

model Device {
  id             String       @id @default(uuid())

  hostname       String
  ipAddress      String?
  macAddress     String?
  osName         String?
  osVersion      String?
  deviceType     DeviceType   @default(WORKSTATION)
  status         DeviceStatus @default(ACTIVE)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  assignedUserId String?
  assignedUser   User?        @relation(fields: [assignedUserId], references: [id])

  softwareInventory      SoftwareInventory[]
  softwareUpdateFindings SoftwareUpdateFinding[]
  vulnerabilityFindings  VulnerabilityFinding[]
  remediationActions     RemediationAction[]

  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model SoftwareInventory {
  id               String         @id @default(uuid())

  softwareName     String
  publisher        String?
  installedVersion String?
  installedPath    String?
  installDate      DateTime?
  lastUsedAt       DateTime?

  source           SoftwareSource @default(MANUAL)
  status           SoftwareStatus @default(INSTALLED)

  deviceId         String
  device           Device         @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  organizationId   String
  organization     Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  updateFindings        SoftwareUpdateFinding[]
  vulnerabilityFindings VulnerabilityFinding[]
  remediationActions    RemediationAction[]

  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@unique([deviceId, softwareName])
  @@index([deviceId])
  @@index([organizationId])
}

model SoftwareUpdateFinding {
  id                  String               @id @default(uuid())

  installedVersion    String?
  latestVersion       String?
  updateAvailable     Boolean              @default(false)
  status              SoftwareUpdateStatus @default(UNKNOWN)
  source              UpdateCheckSource    @default(MANUAL)

  checkedAt           DateTime             @default(now())
  notes               String?

  softwareInventoryId String
  softwareInventory   SoftwareInventory    @relation(fields: [softwareInventoryId], references: [id], onDelete: Cascade)

  deviceId            String
  device              Device               @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  organizationId      String
  organization        Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  vulnerabilityFindings VulnerabilityFinding[]

  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  @@index([softwareInventoryId])
  @@index([deviceId])
  @@index([organizationId])
}

model VulnerabilityFinding {
  id                    String                    @id @default(uuid())

  cveId                 String?
  title                 String
  description           String?

  affectedVersion       String?
  fixedVersion          String?

  publishedDate         DateTime?
  lastModifiedDate      DateTime?

  exploitAvailability   ExploitAvailability       @default(UNKNOWN)
  fixAvailability       FixAvailability           @default(UNKNOWN)
  status                VulnerabilityStatus       @default(OPEN)
  source                VulnerabilitySource       @default(MANUAL)

  referenceUrl          String?
  notes                 String?

  softwareInventoryId   String
  softwareInventory     SoftwareInventory         @relation(fields: [softwareInventoryId], references: [id], onDelete: Cascade)

  softwareUpdateFindingId String?
  softwareUpdateFinding   SoftwareUpdateFinding?  @relation(fields: [softwareUpdateFindingId], references: [id], onDelete: SetNull)

  deviceId              String
  device                Device                    @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  organizationId        String
  organization          Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  remediationActions    RemediationAction[]

  createdAt             DateTime                  @default(now())
  updatedAt             DateTime                  @updatedAt

  @@index([softwareInventoryId])
  @@index([softwareUpdateFindingId])
  @@index([deviceId])
  @@index([organizationId])
  @@index([cveId])
}

model RemediationAction {
  id                      String                         @id @default(uuid())

  actionTitle             String
  actionDescription       String?
  recommendedFix          String?

  actionType              RemediationActionType          @default(UPDATE_SOFTWARE)
  status                  RemediationStatus              @default(PENDING)
  verificationStatus      RemediationVerificationStatus  @default(NOT_VERIFIED)

  dueDate                 DateTime?
  startedAt               DateTime?
  completedAt             DateTime?
  verificationNotes       String?
  notes                   String?

  vulnerabilityFindingId  String
  vulnerabilityFinding    VulnerabilityFinding           @relation(fields: [vulnerabilityFindingId], references: [id], onDelete: Cascade)

  softwareInventoryId     String
  softwareInventory       SoftwareInventory              @relation(fields: [softwareInventoryId], references: [id], onDelete: Cascade)

  deviceId                String
  device                  Device                         @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  organizationId          String
  organization            Organization                   @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  assignedUserId          String?
  assignedUser            User?                          @relation(fields: [assignedUserId], references: [id], onDelete: SetNull)
  evidence                RemediationEvidence[]

  createdAt               DateTime                       @default(now())
  updatedAt               DateTime                       @updatedAt

  @@index([vulnerabilityFindingId])
  @@index([softwareInventoryId])
  @@index([deviceId])
  @@index([organizationId])
  @@index([assignedUserId])
}

model RemediationEvidence {
  id                  String   @id @default(uuid())
  fileName            String
  mimeType            String
  size                Int
  data                Bytes
  createdAt           DateTime @default(now())

  remediationActionId String
  remediationAction   RemediationAction @relation(fields: [remediationActionId], references: [id], onDelete: Cascade)
  uploadedById        String
  uploadedBy          User @relation(fields: [uploadedById], references: [id], onDelete: Cascade)
  organizationId      String
  organization        Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([remediationActionId, createdAt])
  @@index([organizationId])
}

enum OrganizationStatus {
  ACTIVE
  SUSPENDED
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum DeviceType {
  LAPTOP
  DESKTOP
  SERVER
  WORKSTATION
  CLOUD_VM
  NETWORK_DEVICE
  OTHER
}

enum DeviceStatus {
  ACTIVE
  INACTIVE
  RETIRED
}

enum SoftwareSource {
  MANUAL
  SYSTEM_SCAN
  IMPORTED
}

enum SoftwareStatus {
  INSTALLED
  REMOVED
  UNKNOWN
}

enum SoftwareUpdateStatus {
  UP_TO_DATE
  OUTDATED
  UNKNOWN
}

enum UpdateCheckSource {
  MANUAL
  WINGET
  SYSTEM_SCAN
  IMPORTED
}

enum VulnerabilitySource {
  MANUAL
  NVD
  SCANNER
  IMPORTED
}

enum ExploitAvailability {
  UNKNOWN
  NO_KNOWN_EXPLOIT
  PUBLIC_EXPLOIT_AVAILABLE
}

enum FixAvailability {
  UNKNOWN
  FIX_AVAILABLE
  NO_FIX_AVAILABLE
}

enum VulnerabilityStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  ACCEPTED_RISK
  FALSE_POSITIVE
}

enum RemediationActionType {
  UPDATE_SOFTWARE
  CONFIGURATION_CHANGE
  REMOVE_SOFTWARE
  ACCEPT_RISK
  VERIFY_PATCH
  OTHER
}

enum RemediationStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum RemediationVerificationStatus {
  NOT_VERIFIED
  VERIFIED
  FAILED
}
